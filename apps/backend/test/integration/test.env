# Dummy, non-secret values for integration test runs only — loaded via
# dotenv-cli by the `test:integration` script. Points at the isolated
# test Postgres/Redis from docker-compose.test.yml, never the dev stack.
# Safe to commit: every value here is fake and only ever talks to
# disposable, local test infrastructure.

# Prisma 7's driver-adapter query compiler is loaded via a dynamic
# import() at runtime; Jest's CJS module registry can't do that without
# this flag, or every integration spec touching a real PrismaService
# throws "A dynamic import callback was invoked without
# --experimental-vm-modules". Harmless outside Jest — this only affects
# the jest process dotenv-cli spawns.
NODE_OPTIONS=--experimental-vm-modules

DATABASE_URL=postgresql://test:test@localhost:5433/saas_ai_test
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=integration-test-access-secret
JWT_REFRESH_SECRET=integration-test-refresh-secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# GoogleStrategy's constructor throws (and NestJS eagerly instantiates every
# provider in the module graph) if these are unset — none of the integration
# specs exercise real Google OAuth, so these just need to be non-empty.
GOOGLE_CLIENT_ID=integration-test-google-client-id
GOOGLE_CLIENT_SECRET=integration-test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

EMAIL_VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

# Deliberately unreachable — verification/reset emails are allowed to fail
# to send in integration tests (fire-and-forget queue job); real delivery
# is only asserted in the Playwright E2E suite via Mailpit.
SMTP_HOST=127.0.0.1
SMTP_PORT=1

FRONTEND_URL=http://localhost:3001

# Never used for a real network call — checkout/portal calls go through a
# mocked Stripe client in billing specs; only `webhooks.constructEvent`
# (pure local signature verification, no network) runs for real.
STRIPE_SECRET_KEY=sk_test_integration_dummy
STRIPE_WEBHOOK_SECRET=whsec_integration_dummy
STRIPE_PRICE_LITE=price_integration_lite
STRIPE_PRICE_PRO=price_integration_pro
STRIPE_PRICE_ULTRA=price_integration_ultra
STRIPE_PORTAL_RETURN_URL=http://localhost:3001/dashboard/settings
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3001/dashboard?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3001/

AVATAR_UPLOAD_DIR=./test/integration/tmp-uploads
