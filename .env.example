# This file is read by `docker compose up` (all services) AND by any app run
# as a host process (`pnpm --filter backend start:dev`, etc. — dotenv loads
# from the app's own directory in that case; see apps/*/.env.example for the
# per-app copies used by that workflow). Copy this to `.env` and fill it in.
#
# Two kinds of value live in here, and it matters which is which:
#   - Server-to-server (container network): DATABASE_URL, REDIS_URL,
#     SMTP_HOST/PORT. Inside `docker compose up`, docker-compose.yml
#     overrides these to Compose service hostnames (postgres/redis/mailpit)
#     automatically — the values below are for running the backend as a
#     bare host process instead.
#   - Browser-facing: NEXT_PUBLIC_API_URL, GOOGLE_CALLBACK_URL, FRONTEND_URL,
#     STRIPE_*_URL. These are followed by the user's actual browser
#     (redirects, emailed links, client-side fetch), so they must stay
#     `localhost:<host-port>` even when everything else runs in containers.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_ai_dev
POSTGRES_PORT=5432

REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Host ports the backend/frontend containers publish on (also what they
# listen on inside the container, via PORT).
BACKEND_PORT=3000
FRONTEND_PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_ai_dev
REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

JWT_ACCESS_SECRET=#paste secret here
JWT_REFRESH_SECRET=#paste secret here
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

GOOGLE_CLIENT_ID=#paste client id here
GOOGLE_CLIENT_SECRET=#paste secret here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

SMTP_HOST=localhost
SMTP_PORT=1025

EMAIL_VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

# Same Stripe test-mode secret key, two names: STRIPE_SECRET_KEY is used by
# the backend's Stripe SDK client; STRIPE_API_KEY is read by the `stripe`
# Compose service for headless `stripe listen` auth (no interactive
# `stripe login` inside a container). Set them to the same value.
STRIPE_SECRET_KEY=#paste secret here
STRIPE_API_KEY=#paste the same secret key here
# Capture once via `stripe listen --print-secret --forward-to
# localhost:3000/billing/webhook` — stable across restarts, see README.
STRIPE_WEBHOOK_SECRET=#paste secret here

STRIPE_PRICE_LITE=#paste secret here
STRIPE_PRICE_PRO=#paste secret here
STRIPE_PRICE_ULTRA=#paste secret here
STRIPE_PORTAL_RETURN_URL=http://localhost:3001/dashboard/settings
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3001/dashboard?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3001/

AVATAR_UPLOAD_DIR=./uploads/avatars
AVATAR_MAX_SIZE_BYTES=2097152

CRON_AVATAR_CLEANUP_SCHEDULE=0 3 * * *
CRON_WEBHOOK_EVENT_CLEANUP_SCHEDULE=30 3 * * *
CRON_WEBHOOK_EVENT_RETENTION_DAYS=30
